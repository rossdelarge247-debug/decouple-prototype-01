{
  "name": "decouple-site",
  "private": true,
  "version": "1.0.0",
  "description": "decouple.uk: the pages exported from the design project, a thin server layer around them, and the build.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "@vercel/global-config": "^1.5.1"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@fontsource/source-serif-pro": "^5.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
