# Every variable the site reads (docs/SITE-SPEC.md §9). Set them in Vercel, never in git.
# For local runs copy this to .env.local; with none of the service variables set, npm run dev mocks the services.

SITE_ORIGIN=https://decouple.uk
LOGIN_PATH=/studio
OWNER_PASSWORD_HASH=            # npm run hash-password
SESSION_SECRET=                 # 32+ random bytes, e.g. openssl rand -hex 32
TESTER_CODES=                   # fallback only: CODE:label,CODE2:label2
TESTERS_CAN_OPEN_PROTOS=false

APPS_SCRIPT_URL=                # apps-script/SETUP.md
APPS_SCRIPT_SECRET=

RESEND_API_KEY=
MAIL_FROM=Decouple <hello@decouple.uk>

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GLOBAL_CONFIG=                  # the connection string Vercel adds when the Global Config store is connected (EDGE_CONFIG, the old name, also works)
GLOBAL_CONFIG_ID=               # optional: read from the connection string when unset
VERCEL_API_TOKEN=               # scoped to your team; the switches write through Vercel's API with it
VERCEL_TEAM_ID=                 # every Vercel account is a team now, so this is needed
DEPLOY_HOOK_URL=
